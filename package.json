{
  "name": "reelsdl",
  "version": "1.0.0",
  "private": true,
  "description": "Public Instagram reel and photo downloader",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "NODE_ENV=production astro build && node scripts/split-output.mjs",
    "preview": "astro preview",
    "deploy": "npm run build && npx wrangler deploy && vercel --prod"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@astrojs/vercel": "^11.0.11",
    "@fontsource-variable/geist": "^5.3.0",
    "@vercel/functions": "^3.9.7",
    "astro": "^7.3.5",
    "ffmpeg-static": "^5.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
