---
import Base from '../layouts/Base.astro';
import { BlogShell } from '../../components/BlogShell.jsx';
import { DEFAULT_LOCALE, localePath } from '../../lib/i18n.js';
import { blogAlternates, blogCopy, blogIndexJsonLd, blogPath, formatDate, getPosts, postImage, postPath, readingMinutes } from '../../lib/blog.js';
import '../styles/blog.css';

const { pageLocale = DEFAULT_LOCALE, uiLocale = pageLocale } = Astro.props;
const copy = blogCopy(pageLocale);
const posts = await getPosts(pageLocale);
const alternates = await blogAlternates();
---
<Base
  locale={uiLocale}
  pageLocale={pageLocale}
  alternates={alternates}
  title={copy.title}
  description={copy.description}
  keywords={copy.keywords}
  canonical={blogPath(pageLocale)}
>
  {blogIndexJsonLd(posts, pageLocale).map((block) => (
    <script type="application/ld+json" set:html={JSON.stringify(block)} />
  ))}
  <BlogShell client:load initialLocale={uiLocale} pageLocale={pageLocale} alternates={alternates} blogHref={blogPath(pageLocale)}>
    <div class="blog-index">
      <nav class="blog-crumbs" aria-label="Breadcrumb">
        <a href={localePath(pageLocale, '/')}>{copy.home}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{copy.blog}</span>
      </nav>
      <h1>{copy.heading}</h1>
      <p class="blog-lede">{copy.lede}</p>
      <ol class="blog-list">
        {posts.map((post, index) => {
          const image = postImage(post);
          return (
            <li>
              <article class="blog-card">
                {image ? (
                  <a class="blog-card-thumb" href={postPath(post)} tabindex="-1" aria-hidden="true">
                    <img
                      src={image.thumb}
                      width="720"
                      height={Math.round(720 * image.height / image.width)}
                      alt={image.alt}
                      loading={index < 2 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  </a>
                ) : null}
                <div class="blog-card-text">
                  <h2><a href={postPath(post)}>{post.data.title}</a></h2>
                  <p>{post.data.excerpt}</p>
                  <p class="blog-meta">
                    <time datetime={post.data.updated.toISOString()}>{formatDate(post.data.updated, pageLocale)}</time>
                    <span aria-hidden="true">·</span>
                    {readingMinutes(post)} {copy.minRead}
                  </p>
                </div>
              </article>
            </li>
          );
        })}
      </ol>
    </div>
  </BlogShell>
</Base>
