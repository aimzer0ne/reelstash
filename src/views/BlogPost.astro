---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { BlogShell } from '../../components/BlogShell.jsx';
import { localePath } from '../../lib/i18n.js';
import { OG_SIZE, blogCopy, blogPath, formatDate, getPosts, postAlternates, postImage, postJsonLd, postLocale, postPath, postSlug, postTool, readingMinutes } from '../../lib/blog.js';
import '../styles/blog.css';

const { post, uiLocale = postLocale(post) } = Astro.props;
const pageLocale = postLocale(post);
const copy = blogCopy(pageLocale);
const alternates = await postAlternates(postSlug(post));
const { Content, headings } = await render(post);
const sections = headings.filter((heading) => heading.depth === 2);
const tool = postTool(post);
const related = (await getPosts(pageLocale)).filter((item) => item.id !== post.id);
const { data } = post;
const hero = postImage(post);
const social = hero ? { image: hero.og, imageAlt: hero.alt, imageWidth: OG_SIZE.width, imageHeight: OG_SIZE.height } : {};
---
<Base
  locale={uiLocale}
  pageLocale={pageLocale}
  alternates={alternates}
  title={`${data.seoTitle} | ReelsDl.net`}
  description={data.description}
  keywords={data.keywords}
  canonical={postPath(post)}
  ogTitle={data.title}
  twitterTitle={data.title}
  ogType="article"
  publishedTime={data.published.toISOString()}
  modifiedTime={data.updated.toISOString()}
  {...social}
>
  <link slot="head" rel="alternate" type="text/markdown" href={`${postPath(post)}.md`} title="Markdown version" />
  {postJsonLd(post).map((block) => (
    <script type="application/ld+json" set:html={JSON.stringify(block)} />
  ))}
  <BlogShell client:load initialLocale={uiLocale} pageLocale={pageLocale} alternates={alternates} blogHref={blogPath(pageLocale)}>
    <article class="blog-post">
      <nav class="blog-crumbs" aria-label="Breadcrumb">
        <a href={localePath(pageLocale, '/')}>{copy.home}</a>
        <span aria-hidden="true">/</span>
        <a href={blogPath(pageLocale)}>{copy.blog}</a>
      </nav>
      <h1>{data.title}</h1>
      <p class="blog-meta">
        {copy.by}
        <span aria-hidden="true">·</span>
        {copy.updated} <time datetime={data.updated.toISOString()}>{formatDate(data.updated, pageLocale)}</time>
        <span aria-hidden="true">·</span>
        {readingMinutes(post)} {copy.minRead}
      </p>

      {hero ? (
        <figure class="blog-hero">
          <img
            src={hero.src}
            srcset={`${hero.thumb} 720w, ${hero.src} ${hero.width}w`}
            sizes="(max-width: 880px) 100vw, 832px"
            width={hero.width}
            height={hero.height}
            alt={hero.alt}
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      ) : null}

      {data.takeaways.length ? (
        <section class="blog-takeaways" aria-labelledby="blog-takeaways-heading">
          <h2 id="blog-takeaways-heading">{copy.takeaways}</h2>
          <ul>
            {data.takeaways.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      ) : null}

      {sections.length > 2 ? (
        <nav class="blog-toc" aria-label={copy.toc}>
          <p>{copy.toc}</p>
          <ol>
            {sections.map((heading) => (
              <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        </nav>
      ) : null}

      <div class="blog-body">
        <Content />
      </div>

      <aside class="blog-cta" aria-label={tool.name}>
        <p>
          <b>{tool.name}.</b> {copy.cta}
        </p>
        <a class="blog-cta-btn" href={tool.href}>{tool.label}</a>
      </aside>

      {data.faq.length ? (
        <section class="blog-faq" aria-labelledby="blog-faq-heading">
          <h2 id="blog-faq-heading">{copy.faq}</h2>
          <div class="faq-list">
            {data.faq.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </section>
      ) : null}

      {related.length ? (
        <section class="blog-related" aria-labelledby="blog-related-heading">
          <h2 id="blog-related-heading">{copy.more}</h2>
          <ul>
            {related.map((item) => (
              <li><a href={postPath(item)}>{item.data.title}</a></li>
            ))}
          </ul>
        </section>
      ) : null}
    </article>
  </BlogShell>
</Base>
