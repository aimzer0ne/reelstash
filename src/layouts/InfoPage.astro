---
// A help or legal page: only the header hydrates; the article is static HTML.
import Base from './Base.astro';
import { Header } from '../../components/Header.jsx';
import { INFO_PAGES, InfoBody } from '../../components/InfoBody.jsx';

const { pageId } = Astro.props;
const [page] = INFO_PAGES[pageId];
const meta = page.metadata;
---
<Base
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  canonical={meta.alternates.canonical}
  ogTitle={meta.openGraph.title}
  ogDescription={meta.openGraph.description}
  twitterTitle={meta.twitter.title}
  twitterDescription={meta.twitter.description}
>
  {(page.jsonLd || []).map((block) => (
    <script type="application/ld+json" set:html={JSON.stringify(block)} />
  ))}
  <Header client:load active={page.path} />
  <InfoBody pageId={pageId} />
</Base>
