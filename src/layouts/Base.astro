---
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '../styles/globals.css';
import '../styles/logo-type.css';
import '../styles/input-hit.css';
import { localeMeta } from '../../lib/i18n.js';
import { DEFAULT_OG_IMAGE, OG_IMAGE_PATH } from '../../lib/seo.js';
import { pageOgImage } from '../../lib/images.js';

const {
  locale = 'en',
  title,
  description,
  keywords = [],
  canonical = '/',
  ogTitle = title,
  ogDescription = description,
  twitterTitle = title,
  twitterDescription = description,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  ogType = 'website',
  publishedTime,
  modifiedTime
} = Astro.props;

const origin = Astro.site?.href?.replace(/\/$/, '') || 'https://reelsdl.net';
const canonicalUrl = new URL(canonical, `${origin}/`).href;
// Pages that pass no image get their own 1200 × 630 share card, or the site default.
const share = image
  ? { src: image, alt: imageAlt, width: imageWidth, height: imageHeight }
  : pageOgImage(canonical) || { src: OG_IMAGE_PATH, ...DEFAULT_OG_IMAGE };
const imageUrl = new URL(share.src, `${origin}/`).href;
const { dir } = localeMeta(locale);
const keywordList = Array.isArray(keywords) ? keywords.join(', ') : keywords;
---
<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywordList ? <meta name="keywords" content={keywordList} /> : null}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="application-name" content="ReelsDl.net" />
    <meta name="author" content="ReelsDl.net" />
    <meta name="creator" content="ReelsDl.net" />
    <meta name="publisher" content="ReelsDl.net" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="referrer" content="origin" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0b" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('reelsdl-theme');
          if (saved === 'light' || saved === 'dark') document.documentElement.setAttribute('data-theme', saved);
        } catch (e) {}
      })();
    </script>
    <meta name="format-detection" content="telephone=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="ReelsDl.net" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="ReelsDl.net" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={share.alt} />
    <meta property="og:image:width" content={share.width} />
    <meta property="og:image:height" content={share.height} />
    {publishedTime ? <meta property="article:published_time" content={publishedTime} /> : null}
    {modifiedTime ? <meta property="article:modified_time" content={modifiedTime} /> : null}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={twitterTitle} />
    <meta name="twitter:description" content={twitterDescription} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={share.alt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="icon" href="/icon-512.png" sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs" />
    <slot name="head" />
    {import.meta.env.PROD ? (
      <>
        <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4227221684379341"
             crossorigin="anonymous"></script>
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-6EEDJDHHW4"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-6EEDJDHHW4', { anonymize_ip: true, transport_type: 'beacon' });
        </script>
      </>
    ) : null}
  </head>
  <body>
    <slot />
  </body>
</html>
