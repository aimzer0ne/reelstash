---
// A downloader page: header and downloader hydrate as islands; the copy,
// FAQ, and footer below them are static HTML.
import Base from './Base.astro';
import { Downloader } from '../../components/Downloader.jsx';
import { Header } from '../../components/Header.jsx';
import { ToolBody } from '../../components/ToolBody.jsx';
import { getGuideLinks } from '../../lib/blog.js';

const { page, robots, canonical = page.metadata.alternates.canonical } = Astro.props;
const guides = await getGuideLinks();
const meta = page.metadata;
---
<Base
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  canonical={canonical}
  robots={robots}
  ogTitle={meta.openGraph.title}
  ogDescription={meta.openGraph.description}
  twitterTitle={meta.twitter.title}
  twitterDescription={meta.twitter.description}
>
  {(page.jsonLd || []).map((block) => (
    <script type="application/ld+json" set:html={JSON.stringify(block)} />
  ))}
  <Header client:load active={page.path} />
  <main id="home">
    <Downloader
      client:load
      mode={page.mode}
      kicker={page.kicker}
      heading={page.heading}
      lede={page.lede}
      summary={page.summary}
    />
    <ToolBody page={page} guides={guides} />
  </main>
</Base>
