---
import BlogPost from '../../../views/BlogPost.astro';
import { DEFAULT_LOCALE } from '../../../../lib/i18n.js';
import { getPost } from '../../../../lib/blog.js';

const { locale, slug } = Astro.params;
const post = locale === DEFAULT_LOCALE ? null : await getPost(slug, locale);
if (!post) return new Response('Not found', { status: 404 });
---
<BlogPost post={post} />
