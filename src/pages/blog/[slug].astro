---
import BlogPost from '../../views/BlogPost.astro';
import { LANG_COOKIE, resolveDefaultRoute } from '../../../lib/i18n.js';
import { getPost, postAlternates } from '../../../lib/blog.js';

const post = await getPost(Astro.params.slug);
if (!post) return new Response('Not found', { status: 404 });

const route = resolveDefaultRoute({
  cookie: Astro.cookies.get(LANG_COOKIE)?.value,
  accept: Astro.request.headers.get('accept-language'),
  alternates: await postAlternates(Astro.params.slug)
});
if (route.redirect) return Astro.redirect(route.redirect, 302);
---
<BlogPost post={post} uiLocale={route.locale} />
