---
import Base from '../layouts/Base.astro';
import { AppRoot } from '../../components/AppRoot.jsx';
import { LANG_COOKIE, resolveDefaultRoute } from '../../lib/i18n.js';
import { legalPages } from '../../lib/legal.js';

// English only: the interface strings still follow the visitor's language.
const { locale } = resolveDefaultRoute({
  cookie: Astro.cookies.get(LANG_COOKIE)?.value,
  accept: Astro.request.headers.get('accept-language'),
  alternates: {}
});
const meta = legalPages.privacy.metadata;
---
<Base
  locale={locale}
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  canonical={meta.alternates.canonical}
  ogTitle={meta.openGraph.title}
  ogDescription={meta.openGraph.description}
  twitterTitle={meta.twitter.title}
  twitterDescription={meta.twitter.description}
>
  <AppRoot client:load pageId="privacy" initialLocale={locale} />
</Base>
