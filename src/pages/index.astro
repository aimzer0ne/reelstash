---
import ToolPage from '../views/ToolPage.astro';
import { LANG_COOKIE, pageAlternates, resolveDefaultRoute } from '../../lib/i18n.js';

const route = resolveDefaultRoute({
  cookie: Astro.cookies.get(LANG_COOKIE)?.value,
  accept: Astro.request.headers.get('accept-language'),
  alternates: pageAlternates('home')
});
if (route.redirect) return Astro.redirect(route.redirect, 302);
---
<ToolPage pageId="home" uiLocale={route.locale} />
