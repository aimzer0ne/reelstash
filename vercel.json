  "functions": {
    "app/api/resolve/route.js": {
      "maxDuration": 60,
      "includeFiles": "{vendor/**,node_modules/ffmpeg-static/**}"
    },
    "app/api/download/route.js": {
      "maxDuration": 60,
      "includeFiles": "{vendor/**,node_modules/ffmpeg-static/**}"
    },
